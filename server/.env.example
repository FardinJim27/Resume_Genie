# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_resume_analyzer

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI Service (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# AI Service (Groq)
GROQ_API_KEY=your-groq-api-key

# Groq AI Models (optional - defaults provided)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
